# MOSDAC AI Help Bot - Development Environment
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-for-testing-only

# Redis Configuration (will fallback to simple cache if Redis not available)
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_BASE_URL=http://localhost:8000
API_TIMEOUT=30

# Logging Configuration
LOG_LEVEL=DEBUG

# Feature Flags
FEATURE_VOICE_INPUT=true
FEATURE_FILE_UPLOAD=true
FEATURE_OFFLINE_SUPPORT=true
FEATURE_ANALYTICS=true
FEATURE_FEEDBACK=true
FEATURE_ADMIN_PANEL=false

# Rate Limiting (relaxed for development)
RATELIMIT_DEFAULT=1000 per hour
