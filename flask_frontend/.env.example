# MOSDAC AI Help Bot - Flask Frontend Environment Configuration
# Copy this file to .env and update with your actual values

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-change-in-production

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# API Configuration
API_BASE_URL=http://localhost:8000
API_TIMEOUT=30
API_RETRY_ATTEMPTS=3
API_RETRY_BACKOFF=1.0

# Database Configuration (if using PostgreSQL)
DATABASE_URL=postgresql://mosdac:password@localhost:5432/mosdac_frontend

# Security Configuration
WTF_CSRF_ENABLED=true
WTF_CSRF_TIME_LIMIT=3600

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,https://mosdac.gov.in

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=txt,pdf,png,jpg,jpeg,gif,doc,docx

# Feature Flags
FEATURE_VOICE_INPUT=true
FEATURE_FILE_UPLOAD=true
FEATURE_OFFLINE_SUPPORT=true
FEATURE_ANALYTICS=true
FEATURE_FEEDBACK=true
FEATURE_ADMIN_PANEL=false

# Rate Limiting
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_STORAGE_URL=redis://localhost:6379/2

# Cache Configuration
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://localhost:6379/1
CACHE_DEFAULT_TIMEOUT=300

# Session Configuration
SESSION_TYPE=redis
SESSION_PERMANENT=false
SESSION_USE_SIGNER=true
SESSION_KEY_PREFIX=mosdac:
PERMANENT_SESSION_LIFETIME=86400

# Production Configuration (uncomment for production)
# FLASK_ENV=production
# FLASK_DEBUG=0
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAMESITE=Lax

# Docker Configuration
# REDIS_HOST=redis
# REDIS_PORT=6379
# API_BASE_URL=http://api:8000

# Monitoring Configuration (optional)
PROMETHEUS_ENABLED=false
GRAFANA_PASSWORD=admin

# External Services (optional)
SENTRY_DSN=
GOOGLE_ANALYTICS_ID=
HOTJAR_ID=

# Email Configuration (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_INTERVAL=86400
BACKUP_RETENTION=7

# Performance Configuration
WORKERS=4
WORKER_CONNECTIONS=1000
TIMEOUT=30
KEEPALIVE=5
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100

# SSL Configuration (for HTTPS)
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CA_PATH=

# CDN Configuration (optional)
CDN_ENABLED=false
CDN_URL=https://cdn.example.com
CDN_STATIC_URL=https://static.example.com

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_BATCH_SIZE=100

# Notification Configuration
NOTIFICATIONS_ENABLED=true
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Development Tools
PROFILER_ENABLED=false
DEBUG_TOOLBAR_ENABLED=false
